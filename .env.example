# Local setup examples: replace password and secret key privately in .env.
DB_NAME=roomer_dev
DB_USER=roomer_dev
DB_PASSWORD=replace_with_your_local_password
DB_HOST=localhost
DB_PORT=5432
DJANGO_SECRET_KEY=replace_with_a_generated_django_secret_key

# Optional local email settings; messages are printed to the server console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Roomer <no-reply@roomer.local>
