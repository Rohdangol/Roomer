# ============================================
# Roomer - .gitignore
# Django + Python + PostgreSQL
# ============================================


# --------------------
# Virtual Environment
# --------------------
venv/
.venv/
env/


# --------------------
# Environment Variables / Secrets
# --------------------
.env
.env.*
!.env.example


# --------------------
# Python
# --------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.pytest_cache/
.mypy_cache/
.ruff_cache/


# --------------------
# Django
# --------------------
*.log

# Local SQLite database
db.sqlite3
db.sqlite3-journal


# --------------------
# User Uploaded Media
# --------------------
media/


# --------------------
# Static Files Generated by collectstatic
# --------------------
staticfiles/


# --------------------
# VS Code
# --------------------
.vscode/


# --------------------
# PyCharm
# --------------------
.idea/


# --------------------
# Operating System Files
# --------------------
.DS_Store
Thumbs.db
desktop.ini


# --------------------
# Temporary / Backup Files
# --------------------
*.tmp
*.temp
*.bak
*.swp
*~